{
  "name": "dsh-better-display",
  "version": "0.3.7",
  "private": true,
  "description": "DeepSeek Harness 的「阅读」视图插件（自用维护版）：过程折叠、实时思考卡片、最终回答聚焦。",
  "type": "module",
  "license": "MIT",
  "main": "lib/dsh-better-display.js",
  "exports": {
    ".": {
      "default": "./lib/dsh-better-display.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node verify.mjs",
    "test": "node --import tsx/esm --test tests/*.test.ts",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify",
    "dsh:link": "dsh plugin --profile web add link:.",
    "dsh:reload": "npm run build && dsh plugin --profile web remove dsh-better-display && dsh plugin --profile web add link:."
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-store": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-util-workspace-path": ">=0.2.0-rc.1 <0.2.1",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-workspace-path": ">=0.2.0-rc.1 <0.2.1",
    "clsx": "^2.0.0",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-api-remotes": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session-turn-outline": "^0.2.0-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.8.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "conversation",
    "reasoning",
    "streaming"
  ]
}
